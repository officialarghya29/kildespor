# Kildespor configuration (copy to .env or export in shell)
#
# The pipeline runs with $0 external API cost on the free public APIs.
# The NAV job feed uses a rotating public token, fetched automatically at runtime.

# --- Source endpoints (defaults shown; override only if Brreg moves them) ---
KILDESPIR_BRREG_BASE=https://data.brreg.no
KILDESPIR_NAV_FEED_BASE=https://pam-stilling-feed.nav.no

# --- Politeness / budget (challenge limits: 2000 outbound requests, $10/day) ---
KILDESPIR_MAX_REQUESTS=2000
KILDESPIR_TIMEOUT_SECONDS=20

# --- Refresh window ---
# Minimum days between full re-fetches of a profile (reduces load on public APIs)
KILDESPIR_MIN_REFRESH_DAYS=3

# --- Optional: GitHub summary (set in CI) ---
# GITHUB_STEP_SUMMARY=1
